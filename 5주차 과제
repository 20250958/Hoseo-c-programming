#include <stdio.h>
#include <string.h>

#define MAX_PRODUCTS 5

void findAndStock(int product_ids[], char product_names[][100], int product_prices[], int incoming_stock[], int* count);
void findAndSell(int product_ids[], int incoming_stock[], int sales_quantity[], int count);
void printIndividualStatus(int product_ids[], char product_names[][100], int product_prices[], int incoming_stock[], int sales_quantity[], int count);
void printOverallStatus(int product_ids[], char product_names[][100], int product_prices[], int incoming_stock[], int sales_quantity[], int count);


int main() {

    int product_ids[MAX_PRODUCTS] = {0}; 
    char product_names[MAX_PRODUCTS][100];
    int product_prices[MAX_PRODUCTS] = {0};
    int incoming_stock[MAX_PRODUCTS] = {0};
    int sales_quantity[MAX_PRODUCTS] = {0};

    int current_product_count = 0;

    for (int i = 0; i < MAX_PRODUCTS; i++) {
        strcpy(product_names[i], "미지정");
    }

    int menu_choice;

    while (1) {
        printf("\n[쇼핑몰 관리 프로그램]\n");
        printf("> 원하는 메뉴를 선택하세요.(1. 입고, 2. 판매, 3. 개별현황, 4. 전체현황, 5. 종료)\n");
        scanf("%d", &menu_choice);

        if (menu_choice == 1) {
            findAndStock(product_ids, product_names, product_prices, incoming_stock, &current_product_count);
        } 
        else if (menu_choice == 2) {
            findAndSell(product_ids, incoming_stock, sales_quantity, current_product_count);
        } 
        else if (menu_choice == 3) {
            printIndividualStatus(product_ids, product_names, product_prices, incoming_stock, sales_quantity, current_product_count);
        } 
        else if (menu_choice == 4) {
            printOverallStatus(product_ids, product_names, product_prices, incoming_stock, sales_quantity, current_product_count);
        } 
        else if (menu_choice == 5) {
            printf("프로그램을 종료합니다.\n");
            break;
        } else {
            printf("잘못된 메뉴입니다.\n");
        }
    } 

    return 0;
}

void findAndStock(int product_ids[], char product_names[][100], int product_prices[], int incoming_stock[], int* count) {
    int target_id;
    int found_index = -1; 

    printf("상품ID : ");
    scanf("%d", &target_id);

    for (int i = 0; i < *count; i++) {
        if (product_ids[i] == target_id) {
            found_index = i;
            break;
        }
    }

    if (found_index != -1) {
        int index = found_index;
        int amount;

        printf("상품명 : ");
        scanf("%s", product_names[index]);
        printf("추가 입고량 : ");
        scanf("%d", &amount);
        incoming_stock[index] += amount;
        printf("판매가격 : ");
        scanf("%d", &product_prices[index]);
        printf("ID %d 상품 정보가 업데이트되었습니다.\n", target_id);

    } else {
        if (*count < MAX_PRODUCTS) {
            int index = *count;

            product_ids[index] = target_id;

            printf("상품명 : ");
            scanf("%s", product_names[index]);
            printf("입고량 : ");
            scanf("%d", &incoming_stock[index]);
            printf("판매가격 : ");
            scanf("%d", &product_prices[index]);

            (*count)++;
            printf("ID %d 상품이 신규 등록되었습니다.\n", target_id);

        } else {
            printf("오류: 상품은 최대 %d개까지만 등록할 수 있습니다.\n", MAX_PRODUCTS);
        }
    }
}

void findAndSell(int product_ids[], int incoming_stock[], int sales_quantity[], int count) {
    int target_id;
    int found_index = -1;

    printf("상품ID : ");
    scanf("%d", &target_id);

    for (int i = 0; i < count; i++) {
        if (product_ids[i] == target_id) {
            found_index = i;
            break;
        }
    }

    if (found_index != -1) {
        int index = found_index;
        int amount;
        int current_stock = incoming_stock[index] - sales_quantity[index];

        printf("판매량 : ");
        scanf("%d", &amount);

        if (amount > current_stock) {
            printf("오류: 재고가 부족합니다. (현재 재고: %d개)\n", current_stock);
        } else {
            sales_quantity[index] += amount;
            printf("ID %d 상품 %d개 판매 완료.\n", target_id, amount);
        }
    } else {
        printf("오류: ID %d 상품을 찾을 수 없습니다.\n", target_id);
    }
}

void printIndividualStatus(int product_ids[], char product_names[][100], int product_prices[], int incoming_stock[], int sales_quantity[], int count) {
    int target_id;
    int found_index = -1;

    printf("조회할 상품ID : ");
    scanf("%d", &target_id);

    for (int i = 0; i < count; i++) {
        if (product_ids[i] == target_id) {
            found_index = i;
            break;
        }
    }

    if (found_index != -1) {
        int i = found_index;
        int current_stock = incoming_stock[i] - sales_quantity[i];
        int total_sales_amount = product_prices[i] * sales_quantity[i];

        printf("\n--- 개별 상품 현황 (ID: %d) ---\n", product_ids[i]);
        printf("상품명: %s\n", product_names[i]);
        printf("상품가격: %d원\n", product_prices[i]);
        printf("총 입고량: %d\n", incoming_stock[i]);
        printf("총 판매량: %d\n", sales_quantity[i]);
        printf("현재 재고: %d\n", current_stock);
        printf("총 판매금액: %d원\n", total_sales_amount);
        printf("--------------------------------\n");

    } else {
        printf("오류: ID %d 상품을 찾을 수 없습니다.\n", target_id);
    }
}

void printOverallStatus(int product_ids[], char product_names[][100], int product_prices[], int incoming_stock[], int sales_quantity[], int count) {

    if (count == 0) {
        printf("등록된 상품이 없습니다.\n");
        return;
    }

    int current_stock[MAX_PRODUCTS];
    int total_sales = 0;
    int total_incoming = 0;
    float sales_rate = 0.0;

    for (int i = 0; i < count; i++) {
        current_stock[i] = incoming_stock[i] - sales_quantity[i];
        total_sales += sales_quantity[i];
        total_incoming += incoming_stock[i];
    }

    int max_sales_quantity = sales_quantity[0];
    int max_sales_index = 0; 
    int min_sales_quantity = sales_quantity[0];
    int min_sales_index = 0;

    for (int i = 1; i < count; i++) {
        if (sales_quantity[i] > max_sales_quantity) {
            max_sales_quantity = sales_quantity[i];
            max_sales_index = i;
        }
        if (sales_quantity[i] < min_sales_quantity) {
            min_sales_quantity = sales_quantity[i];
            min_sales_index = i;
        }
    }

    if (total_incoming > 0) {
        sales_rate = ((float)total_sales / total_incoming) * 100.0;
    }

    printf("\n--- 전체 상품 현황 (총 %d종) ---\n", count);

    printf("재고수량 : ");
    for (int i = 0; i < count; i++) {
        printf("%d ", current_stock[i]);
    }
    printf("\n");

    printf("총 판매량 : %d (판매율 %.2f%%)\n", total_sales, sales_rate);

    printf("가장 많이 판매된 상품 : ID %d, 상품명 : %s, 판매량 %d\n", product_ids[max_sales_index], product_names[max_sales_index], max_sales_quantity);
    printf("가장 적게 판매된 상품 : ID %d, 상품명 : %s, 판매량 %d\n", product_ids[min_sales_index], product_names[min_sales_index], min_sales_quantity);

    for (int i = 0; i < count; i++) {
        if (current_stock[i] <= 2) {
            printf("상품 ID %d : 상품명 : %s 재고부족(%d)\n", product_ids[i], product_names[i], current_stock[i]);
        }
    }
    printf("--------------------------------\n");
}
